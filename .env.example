# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

# Your MetaMask deployer wallet private key (without 0x prefix is fine — script handles both)
PRIVATE_KEY=your_metamask_private_key_here

# Get a free API key from https://polygonscan.com/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# Optional: override the default RPC endpoints
# AMOY_RPC_URL=https://rpc-amoy.polygon.technology
# POLYGON_RPC_URL=https://polygon-rpc.com

# Optional: enable gas cost reporting during tests
# REPORT_GAS=true
